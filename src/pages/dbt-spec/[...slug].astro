---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const docs = (await getCollection("spec")).sort((a, b) => a.data.order - b.data.order);
  return docs.map((doc, i) => ({
    params: { slug: doc.id },
    props: { doc, prev: docs[i - 1] ?? null, next: docs[i + 1] ?? null, total: docs.length },
  }));
}

const { doc, prev, next, total } = Astro.props;
const { Content } = await render(doc);
---
<BaseLayout title={doc.data.title}>
  <article>
    <header class="doc-header">
      <span class="text-label">
        <a href="/dbt-spec/">DBT v4 Spec</a>
        &middot; doc {doc.data.order} of {total}
      </span>
      <h1 class="article-title">{doc.data.title}</h1>
      <p class="doc-desc">{doc.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="doc-nav">
      {prev ? (
        <a href={`/dbt-spec/${prev.id}/`} class="doc-nav-link">&larr; {prev.data.title}</a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={`/dbt-spec/${next.id}/`} class="doc-nav-link">{next.data.title} &rarr;</a>
      ) : (
        <span />
      )}
    </nav>
  </article>
</BaseLayout>

<script>
  import "../../scripts/mermaid-diagrams.ts";
</script>

<style>
  .doc-header {
    margin-bottom: var(--spacing-xl);
  }
  .doc-header a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .doc-header a:hover {
    text-decoration: underline;
  }
  .doc-desc {
    margin-top: var(--spacing-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .doc-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid color-mix(in srgb, var(--color-text-primary) 12%, transparent);
  }
  .doc-nav-link {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .doc-nav-link:hover {
    text-decoration: underline;
  }

  /* Tables — the spec is table-heavy; the blog's .prose never needed them */
  .prose :global(table) {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: var(--spacing-lg) 0;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 15%, transparent);
    padding: 6px 10px;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    background: color-mix(in srgb, var(--color-text-primary) 7%, transparent);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  /* Mermaid diagrams */
  .prose :global(.mermaid) {
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-md);
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 10%, transparent);
    border-radius: 8px;
    overflow-x: auto;
    display: flex;
    justify-content: center;
    background: color-mix(in srgb, var(--color-text-primary) 3%, transparent);
  }
  .prose :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }
</style>
